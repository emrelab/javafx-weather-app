# OpenWeatherMap API anahtarı — bu dosyayı .env olarak kopyalayın
# https://openweathermap.org/api adresinden ücretsiz anahtar alabilirsiniz.
#
# Kullanım:
#   cp .env.example .env
#   # sonra .env içindeki değeri kendi anahtarınızla değiştirin
#
# .env sürüm kontrolüne girmez; bu örnek dosya yalnızca şablon içindir.

OWM_API_KEY=buraya_kendi_anahtariniz
